<div class="content" style="margin-left: 1%" ng-controller="ctrl_manageTasks as ctrl" ng-init="ctrl.getNewTasks()">

    <h6 class="content-group text-semibold col-lg-12">
        <button type="button" class="btn btn-info" ng-click="ctrl.ShowRegisterTask()">Add New Task<i class="glyphicon glyphicon-plus position-right"></i></button>
    </h6>

    <!-- Register Employees Div -->
    <div id="registerDiv" style="display:none">
        <div class="resize panel panel-flat col-lg-8" style="overflow: auto">
            <div class="panel-heading">
                <h4 class="panel-title" style="color:black;"><b>Add New Task</b></h4>
            </div>

            <div class="panel-body">
                <form class="form-horizontal col-lg-12" name="registerForm">
                    <div class="form-group">
                        <div class="col-lg-12">
                            <div class="row">
                                <div class="col-md-12">
                                    <input style="display:none;" type="text" class="form-control" ng-model="ctrl.task.id" autocomplete="off" ng-required="true">
                                    <input style="display:none;" type="text" class="form-control" ng-model="ctrl.task.t_id" autocomplete="off" ng-required="true">

                                    <!-- Name -->
                                    <div class="form-group">
                                        <label class="control-label col-lg-4" style="color:black;">Type</label>
                                        <div class="col-lg-4">
                                            <input type="text" class="form-control" ng-model="ctrl.task.type" autocomplete="off" ng-required="true">
                                        </div>
                                    </div>

                                    <!-- Phone -->
                                    <div class="form-group">
                                        <label class="control-label col-lg-4" style="color:black;">Source</label>
                                        <div class="col-lg-4">
                                            <input type="text" class="form-control" ng-model="ctrl.task.source" autocomplete="off">
                                        </div>
                                    </div>
                                    <!-- Email -->
                                    <div class="form-group">
                                        <label class="control-label col-lg-4" style="color:black;">Status</label>
                                        <div class="col-lg-4">
                                            <input type="text" class="form-control" ng-model="ctrl.task.status" autocomplete="off">
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        <label class="control-label col-lg-4" style="color:black;">Narration</label>
                                        <div class="col-lg-4">
                                            <textarea class="form-control" rows="3" cols="50"
                                                      ng-model="ctrl.task.narration" autocomplete="off">
                                            </textarea>
                                        </div>
                                    </div>


                                    <!-- Buttons -->
                                    <div class="text-center col-lg-12">
                                        <button ng-if="ctrl.task.t_id" type="button" class="btn btn-info" ng-click="ctrl.editTask()">Edit Task<i class="glyphicon glyphicon-refresh position-right"></i></button>
                                        <button ng-if="!ctrl.task.t_id" type="button" class="btn btn-info" ng-click="ctrl.createTask()">Create Task<i class="glyphicon glyphicon-refresh position-right"></i></button>
                                        <button type="button" class="btn btn-danger" ng-click="ctrl.HideModify()">Cancel <i class="glyphicon glyphicon-remove position-right"></i></button>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Employees Table -->
    <div class="resize panel panel-flat col-lg-12" style="overflow:auto;">
        <div class="panel-body">
            <h4><b>Active Employees</b></h4>
            <table id="taskstable" class="display" style="width:100%;">
                <thead>
                    <tr>
                        <td>Task ID</td>
                        <td>Type</td>
                        <td>Souce</td>
                        <td>Status</td>
                        <td>Narration</td>
                        <td>Employee</td>
                        <td></td>
                        <td></td>
                    </tr>
                </thead>

            </table>
        </div>
    </div>
</div>