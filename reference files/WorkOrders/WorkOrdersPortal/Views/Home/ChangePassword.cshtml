<div class="content" style="margin-left: 1%" ng-controller="ctrl_changePassword as ctrl">

    <h6 class="content-group text-semibold">
        Change Password
    </h6>

    <div class="resize panel panel-flat col-lg-8" style="overflow: hidden">
        <div class="panel-heading">
            <h6 class="panel-title" style="color:black;">Change Password</h6>
            <div class="heading-elements">
                <ul class="icons-list">
                    <li><a data-action="collapse"></a></li>
                    <li><a data-action="reload"></a></li>
                    <li><a data-action="close"></a></li>
                </ul>
            </div>
        </div>

        <div class="panel-body">
            <form class="form-horizontal col-lg-12" name="changePasswordForm">
                <div class="form-group">
                    <div class="col-lg-12">

                        <div class="row">
                            <div class="col-md-12">

                                <!-- New Password -->
                                <div class="form-group">
                                    <label class="control-label col-lg-4" style="color:black;">New Password</label>
                                    <div class="col-lg-4">
                                        <input type="text" class="form-control" id="password" ng-model="ctrl.user.adminpass" autocomplete="off" ng-required="true">
                                    </div>
                                </div>

                                <!-- Confirm New password -->
                                <div class="form-group">
                                    <label class="control-label col-lg-4" style="color:black;">Confirm New Password</label>
                                    <div class="col-lg-4">
                                        <input type="text" class="form-control" id="confirmPassword" onkeyup="checkPasswords()" ng-model="ctrl.user.confirm_pass" autocomplete="off" ng-required="true">
                                    </div>
                                    <div class="col-lg-2">
                                        <span id="error" style="display:none; color: red;">
                                            Passwords do not match
                                        </span>
                                        
                                    </div>
                                </div>

                                <!-- Buttons -->
                                <div class="text-center col-lg-12">
                                    <button type="button" id="save" class="btn btn-info" ng-disabled="changePasswordForm.$invalid" ng-click="changePasswordForm.$valid && ctrl.Save()">Save<i class="glyphicon glyphicon-refresh position-right"></i></button>
                                    <button type="button" class="btn btn-danger" ng-disabled="changePasswordForm.$pristine" ng-click="ctrl.ClearChangePasswordForm()">Clear <i class="glyphicon glyphicon-remove position-right"></i></button>
                                </div>

                            </div>

                        </div>

                    </div>

                </div>
            </form>

        </div>

    </div>

</div>

<script>
    var adminName = "@HttpContext.Current.User.Identity.Name";
    var password = document.getElementById("password");
    var confirmPassword = document.getElementById("confirmPassword");
    var errorDiv = document.getElementById("error")

    function checkPasswords() {
        if (password.value != confirmPassword.value) {
            errorDiv.style.display = "";
            document.getElementById("save").disabled = true;
        }
        else {
            errorDiv.style.display = "none";
            document.getElementById("save").disabled = false;
        }
    }

</script>
